{
  "meta": {
    "name": "Aurora Gradients",
    "version": "1.0",
    "description": "Inspired by the Northern Lights — flowing, multi-color gradients that animate subtly in the background. Surfaces blend seamlessly through color transitions, buttons glow with gradient borders, and shadows carry color tint matching the gradient palette. Ideal for apps that want to feel alive, magical, and emotionally expressive — where the background itself is part of the experience.",
    "mood": ["vibrant", "dreamy", "magical", "expressive"],
    "visualWeight": "color-heavy",
    "bestFor": ["meditation", "mood-tracker", "creative-tools", "music-discovery", "social-creative", "fantasy-gaming"]
  },
  "color": {
    "palette": {
      "background": "linear-gradient(160deg, #1A0533, #0D1B3E, #0A2A3F, #0D1B3E, #1A0533)",
      "surface": "rgba(255,255,255,0.08)",
      "surfaceVariant": "rgba(255,255,255,0.05)",
      "surfaceElevated": "rgba(255,255,255,0.12)",
      "textPrimary": "rgba(255,255,255,0.95)",
      "textSecondary": "rgba(255,255,255,0.65)",
      "textTertiary": "rgba(255,255,255,0.35)",
      "textInverse": "#0D1B3E",
      "accent": "#A855F7",
      "accentVariant": "#7C3AED",
      "accentSubtle": "rgba(168,85,247,0.15)",
      "onAccent": "#FFFFFF"
    },
    "semantic": {
      "success": { "color": "#34D399", "background": "rgba(52,211,153,0.15)" },
      "warning": { "color": "#FBBF24", "background": "rgba(251,191,36,0.15)" },
      "error": { "color": "#F87171", "background": "rgba(248,113,113,0.15)" },
      "info": { "color": "#60A5FA", "background": "rgba(96,165,250,0.15)" }
    },
    "gradient": [
      { "name": "auroraMesh1", "colors": ["#FF0080", "#FF8C00", "#40E0D0"], "angle": 45 },
      { "name": "auroraMesh2", "colors": ["#7928CA", "#FF0080", "#FF8C00"], "angle": 180 },
      { "name": "auroraMesh3", "colors": ["#40E0D0", "#7928CA", "#1E3A8A"], "angle": 270 },
      { "name": "buttonGlow", "colors": ["#A855F7", "#EC4899"], "angle": 135 },
      { "name": "cardShine", "colors": ["rgba(255,255,255,0.10)", "rgba(255,255,255,0.02)"], "angle": 180 }
    ]
  },
  "typography": {
    "fonts": {
      "primary": "SF Pro Display",
      "secondary": "SF Pro Text",
      "mono": "SF Mono"
    },
    "scale": {
      "caption2": { "size": 11, "weight": 400, "lineHeight": 13, "letterSpacing": 0.1 },
      "caption1": { "size": 12, "weight": 400, "lineHeight": 16, "letterSpacing": 0 },
      "footnote": { "size": 13, "weight": 400, "lineHeight": 18, "letterSpacing": -0.06 },
      "subhead": { "size": 15, "weight": 500, "lineHeight": 20, "letterSpacing": -0.2 },
      "callout": { "size": 16, "weight": 400, "lineHeight": 21, "letterSpacing": -0.25 },
      "body": { "size": 17, "weight": 400, "lineHeight": 22, "letterSpacing": -0.35 },
      "headline": { "size": 17, "weight": 600, "lineHeight": 22, "letterSpacing": -0.35 },
      "title3": { "size": 20, "weight": 600, "lineHeight": 25, "letterSpacing": -0.35 },
      "title2": { "size": 22, "weight": 600, "lineHeight": 28, "letterSpacing": -0.4 },
      "title1": { "size": 28, "weight": 700, "lineHeight": 34, "letterSpacing": -0.4 },
      "largeTitle": { "size": 34, "weight": 700, "lineHeight": 41, "letterSpacing": -0.4 },
      "hero": { "size": 48, "weight": 700, "lineHeight": 52, "letterSpacing": -0.4 }
    }
  },
  "spacing": {
    "grid": 4,
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 36,
    "xxl": 52,
    "pageMargin": 20,
    "sectionGap": 28,
    "cardPadding": 22,
    "navBarHeight": 48
  },
  "border": {
    "radius": {
      "none": 0,
      "sm": 6,
      "md": 14,
      "lg": 20,
      "xl": 28,
      "full": 9999
    },
    "width": 1,
    "color": "rgba(255,255,255,0.15)",
    "style": "solid"
  },
  "shadow": {
    "elevation": {
      "0": { "color": "transparent", "offsetY": 0, "blur": 0, "spread": 0 },
      "1": { "color": "rgba(168,85,247,0.15)", "offsetY": 4, "blur": 16, "spread": 0 },
      "2": { "color": "rgba(168,85,247,0.20)", "offsetY": 8, "blur": 32, "spread": 0 },
      "3": { "color": "rgba(236,72,153,0.20)", "offsetY": 16, "blur": 48, "spread": -4 },
      "glow": { "color": "rgba(168,85,247,0.35)", "offsetY": 0, "blur": 40, "spread": 4 }
    }
  },
  "animation": {
    "duration": { "instant": 100, "fast": 200, "normal": 350, "slow": 600, "entrance": 500 },
    "easing": {
      "default": [0.34, 1.56, 0.64, 1],
      "easeIn": [0.42, 0, 1, 1],
      "easeOut": [0, 0, 0.58, 1],
      "easeInOut": [0.42, 0, 0.58, 1]
    },
    "spring": {
      "gentle": { "response": 0.65, "dampingFraction": 0.75 },
      "bouncy": { "response": 0.55, "dampingFraction": 0.55 },
      "snappy": { "response": 0.4, "dampingFraction": 0.8 }
    }
  },
  "component": {
    "navBar": {
      "height": 48,
      "background": "rgba(13,27,62,0.7)",
      "blur": 25,
      "hasDivider": false,
      "dividerColor": "transparent",
      "backIcon": { "name": "chevron.left", "weight": "medium", "size": 20 },
      "titleStyle": "title3",
      "actionIconSize": 24,
      "actionIconWeight": "medium",
      "horizontalPadding": 20,
      "gradientBorder": "1px solid rgba(255,255,255,0.1)"
    },
    "tabBar": {
      "height": 56,
      "background": "rgba(13,27,62,0.75)",
      "blur": 25,
      "hasDivider": false,
      "dividerColor": "transparent",
      "iconSize": 22,
      "labelStyle": "caption2",
      "activeColor": "#A855F7",
      "inactiveColor": "rgba(255,255,255,0.35)",
      "badge": { "size": 16, "background": "#F87171", "textColor": "#FFFFFF", "fontSize": 10 },
      "gradientBorder": "1px solid rgba(255,255,255,0.08)"
    },
    "button": {
      "primary": {
        "height": 52, "radius": 16, "paddingH": 28,
        "background": "linear-gradient(135deg, #A855F7, #EC4899)", "textColor": "#FFFFFF",
        "border": { "width": 0, "color": "transparent" },
        "shadow": "elevation-glow",
        "font": "headline",
        "disabled": { "background": "rgba(255,255,255,0.08)", "textColor": "rgba(255,255,255,0.25)" }
      },
      "secondary": {
        "height": 52, "radius": 16, "paddingH": 28,
        "background": "rgba(255,255,255,0.08)", "textColor": "rgba(255,255,255,0.95)",
        "border": { "width": 1, "color": "rgba(255,255,255,0.12)" },
        "shadow": "elevation-0",
        "font": "headline"
      },
      "tertiary": {
        "height": 44, "radius": 12, "paddingH": 16,
        "background": "transparent", "textColor": "#A855F7",
        "border": { "width": 0, "color": "transparent" },
        "shadow": "elevation-0",
        "font": "subhead"
      },
      "destructive": {
        "height": 52, "radius": 16, "paddingH": 28,
        "background": "linear-gradient(135deg, #F87171, #EF4444)", "textColor": "#FFFFFF",
        "border": { "width": 0, "color": "transparent" },
        "shadow": "elevation-glow",
        "font": "headline"
      },
      "ghost": {
        "height": 44, "radius": 12, "paddingH": 12,
        "background": "transparent", "textColor": "rgba(255,255,255,0.65)",
        "border": { "width": 0, "color": "transparent" },
        "shadow": "elevation-0",
        "font": "subhead"
      }
    },
    "card": {
      "padding": 22,
      "radius": 20,
      "background": "rgba(255,255,255,0.06)",
      "border": { "width": 1, "color": "rgba(255,255,255,0.10)" },
      "shadow": "elevation-1",
      "imageRatio": 1.5,
      "gap": 18
    },
    "input": {
      "height": 52,
      "radius": 14,
      "background": "rgba(255,255,255,0.06)",
      "border": { "width": 1, "color": "rgba(255,255,255,0.10)" },
      "focusBorder": { "width": 1.5, "color": "#A855F7" },
      "placeholder": "rgba(255,255,255,0.30)",
      "textColor": "rgba(255,255,255,0.95)",
      "paddingH": 16,
      "font": "body",
      "error": { "border": { "width": 1.5, "color": "#F87171" }, "messageColor": "#F87171" }
    },
    "chip": {
      "height": 34,
      "radius": 12,
      "paddingH": 14,
      "background": "rgba(255,255,255,0.06)",
      "textColor": "rgba(255,255,255,0.65)",
      "font": "caption1",
      "selected": { "background": "rgba(168,85,247,0.25)", "textColor": "#A855F7" },
      "border": { "width": 1, "color": "rgba(255,255,255,0.08)" }
    },
    "badge": {
      "size": 18,
      "radius": 9999,
      "background": "#F87171",
      "textColor": "#FFFFFF",
      "font": "caption2",
      "position": "topTrailing"
    },
    "avatar": {
      "sm": { "size": 30, "radius": 9999, "border": { "width": 2, "color": "rgba(168,85,247,0.5)" } },
      "md": { "size": 44, "radius": 9999, "border": { "width": 2, "color": "rgba(168,85,247,0.5)" } },
      "lg": { "size": 60, "radius": 9999, "border": { "width": 3, "color": "rgba(168,85,247,0.5)" } },
      "xl": { "size": 88, "radius": 24, "border": { "width": 3, "color": "rgba(168,85,247,0.5)" } }
    },
    "divider": {
      "height": 0.5,
      "color": "rgba(255,255,255,0.08)",
      "inset": 20,
      "style": "solid"
    },
    "toast": {
      "paddingH": 20,
      "paddingV": 14,
      "radius": 16,
      "background": "rgba(13,27,62,0.9)",
      "textColor": "#FFFFFF",
      "font": "subhead",
      "position": "bottom",
      "duration": 3000,
      "border": { "width": 1, "color": "rgba(168,85,247,0.3)" }
    },
    "sheet": {
      "radius": 24,
      "background": "rgba(13,27,62,0.85)",
      "handleColor": "rgba(255,255,255,0.25)",
      "handleWidth": 40,
      "handleHeight": 5,
      "padding": 24,
      "blur": 20
    }
  },
  "iconography": {
    "style": "SF Symbols",
    "defaultWeight": "medium",
    "sizeMap": { "sm": 14, "md": 20, "lg": 24, "xl": 32, "nav": 24, "tab": 22, "button": 18 }
  },
  "composition": {
    "discovery": {
      "layoutDensity": "airy-glow",
      "heroStyle": "gradient-mesh-hero",
      "cardArrangement": "glowing-card-grid",
      "scrollBehavior": "gradient-shift-on-scroll",
      "maxColumns": 2,
      "sectionHeaderStyle": "title3-gradient-text"
    },
    "action": {
      "formDensity": "airy",
      "ctaPlacement": "glowing-gradient-bottom",
      "fieldGrouping": "gradient-border-groups",
      "progressStyle": "gradient-bar",
      "keyboardHandling": "gradient-shift-keyboard"
    },
    "consumption": {
      "mediaFill": "gradient-overlay-media",
      "chromeOpacity": "gradient-edge-fade",
      "infoPlacement": "glowing-card-bottom",
      "scrollEffect": "gradient-parallax"
    },
    "management": {
      "rowDensity": "airy",
      "swipeStyle": "gradient-reveal-row",
      "sortPosition": "gradient-chip-group",
      "editModeTransition": "gradient-pulse"
    },
    "social": {
      "avatarProminence": "medium-glow-ring",
      "contentPadding": 22,
      "reactionStyle": "gradient-icon-pills",
      "composePosition": "gradient-floating-button"
    }
  }
}
