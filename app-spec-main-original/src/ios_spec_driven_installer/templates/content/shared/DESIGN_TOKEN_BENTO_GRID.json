{
  "meta": {
    "name": "Bento Grid",
    "version": "2.0",
    "description": "Structured Apple-like layout with bold rounded cards on a soft neutral canvas. Content is organized into distinct card modules (bento boxes) with generous spacing, subtle shadows, and a clear typographic hierarchy. Ideal for content-heavy apps that need visual order without feeling cluttered.",
    "mood": ["structured", "friendly", "premium", "calm"],
    "visualWeight": "medium",
    "bestFor": ["dashboard", "content-discovery", "productivity", "education", "health-summary"]
  },
  "color": {
    "palette": {
      "background": "#F4F5F7",
      "surface": "#FFFFFF",
      "surfaceVariant": "#EAECEF",
      "surfaceElevated": "#FAFBFC",
      "textPrimary": "#0F172A",
      "textSecondary": "#475569",
      "textTertiary": "#94A3B8",
      "textInverse": "#FFFFFF",
      "accent": "#2563EB",
      "accentVariant": "#1D4ED8",
      "accentSubtle": "#DBEAFE",
      "onAccent": "#FFFFFF"
    },
    "semantic": {
      "success": { "color": "#059669", "background": "#ECFDF5" },
      "warning": { "color": "#D97706", "background": "#FFFBEB" },
      "error": { "color": "#DC2626", "background": "#FEF2F2" },
      "info": { "color": "#2563EB", "background": "#EFF6FF" }
    },
    "gradient": [
      { "name": "heroOverlay", "colors": ["rgba(15,23,42,0)", "rgba(15,23,42,0.6)"], "angle": 180 },
      { "name": "accentGlow", "colors": ["#2563EB", "#7C3AED"], "angle": 135 }
    ]
  },
  "typography": {
    "fonts": {
      "primary": "SF Pro Display",
      "secondary": "SF Pro Text",
      "mono": "SF Mono"
    },
    "scale": {
      "caption2": { "size": 11, "weight": 400, "lineHeight": 13, "letterSpacing": 0.07 },
      "caption1": { "size": 12, "weight": 400, "lineHeight": 16, "letterSpacing": 0 },
      "footnote": { "size": 13, "weight": 400, "lineHeight": 18, "letterSpacing": -0.08 },
      "subhead": { "size": 15, "weight": 400, "lineHeight": 20, "letterSpacing": -0.24 },
      "callout": { "size": 16, "weight": 400, "lineHeight": 21, "letterSpacing": -0.32 },
      "body": { "size": 17, "weight": 400, "lineHeight": 22, "letterSpacing": -0.41 },
      "headline": { "size": 17, "weight": 600, "lineHeight": 22, "letterSpacing": -0.41 },
      "title3": { "size": 20, "weight": 400, "lineHeight": 25, "letterSpacing": -0.45 },
      "title2": { "size": 22, "weight": 400, "lineHeight": 28, "letterSpacing": -0.5 },
      "title1": { "size": 28, "weight": 400, "lineHeight": 34, "letterSpacing": -0.5 },
      "largeTitle": { "size": 34, "weight": 700, "lineHeight": 41, "letterSpacing": -0.5 },
      "hero": { "size": 48, "weight": 700, "lineHeight": 52, "letterSpacing": -0.5 }
    }
  },
  "spacing": {
    "grid": 4,
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "pageMargin": 16,
    "sectionGap": 24,
    "cardPadding": 20,
    "navBarHeight": 44
  },
  "border": {
    "radius": {
      "none": 0,
      "sm": 4,
      "md": 8,
      "lg": 16,
      "xl": 24,
      "full": 9999
    },
    "width": 1,
    "color": "#E2E8F0",
    "style": "solid"
  },
  "shadow": {
    "elevation": {
      "0": { "color": "rgba(15,23,42,0.0)", "offsetY": 0, "blur": 0, "spread": 0 },
      "1": { "color": "rgba(15,23,42,0.04)", "offsetY": 2, "blur": 8, "spread": 0 },
      "2": { "color": "rgba(15,23,42,0.06)", "offsetY": 4, "blur": 16, "spread": 0 },
      "3": { "color": "rgba(15,23,42,0.08)", "offsetY": 8, "blur": 24, "spread": 0 },
      "4": { "color": "rgba(15,23,42,0.12)", "offsetY": 16, "blur": 32, "spread": -4 },
      "5": { "color": "rgba(15,23,42,0.16)", "offsetY": 24, "blur": 48, "spread": -8 }
    }
  },
  "animation": {
    "duration": { "instant": 100, "fast": 200, "normal": 300, "slow": 500, "entrance": 400 },
    "easing": {
      "default": [0.25, 0.1, 0.25, 1],
      "easeIn": [0.42, 0, 1, 1],
      "easeOut": [0, 0, 0.58, 1],
      "easeInOut": [0.42, 0, 0.58, 1]
    },
    "spring": {
      "gentle": { "response": 0.55, "dampingFraction": 0.825 },
      "bouncy": { "response": 0.55, "dampingFraction": 0.65 },
      "snappy": { "response": 0.35, "dampingFraction": 0.85 }
    }
  },
  "component": {
    "navBar": {
      "height": 44,
      "background": "rgba(244,245,247,0.85)",
      "blur": 20,
      "hasDivider": true,
      "dividerColor": "#E2E8F0",
      "backIcon": { "name": "chevron.left", "weight": "medium", "size": 20 },
      "titleStyle": "headline",
      "actionIconSize": 24,
      "actionIconWeight": "regular",
      "horizontalPadding": 16
    },
    "tabBar": {
      "height": 49,
      "background": "rgba(255,255,255,0.92)",
      "blur": 20,
      "hasDivider": true,
      "dividerColor": "#E2E8F0",
      "iconSize": 24,
      "labelStyle": "caption2",
      "activeColor": "#2563EB",
      "inactiveColor": "#94A3B8",
      "badge": { "size": 16, "background": "#DC2626", "textColor": "#FFFFFF", "fontSize": 10 }
    },
    "button": {
      "primary": {
        "height": 50, "radius": 16, "paddingH": 24,
        "background": "#2563EB", "textColor": "#FFFFFF",
        "border": { "width": 0, "color": "transparent" },
        "shadow": "elevation-2",
        "font": "headline",
        "disabled": { "background": "#CBD5E1", "textColor": "#94A3B8" }
      },
      "secondary": {
        "height": 50, "radius": 16, "paddingH": 24,
        "background": "#DBEAFE", "textColor": "#1D4ED8",
        "border": { "width": 0, "color": "transparent" },
        "shadow": "elevation-0",
        "font": "headline"
      },
      "tertiary": {
        "height": 44, "radius": 12, "paddingH": 16,
        "background": "transparent", "textColor": "#2563EB",
        "border": { "width": 0, "color": "transparent" },
        "shadow": "elevation-0",
        "font": "subhead"
      },
      "destructive": {
        "height": 50, "radius": 16, "paddingH": 24,
        "background": "#DC2626", "textColor": "#FFFFFF",
        "border": { "width": 0, "color": "transparent" },
        "shadow": "elevation-0",
        "font": "headline"
      },
      "ghost": {
        "height": 44, "radius": 12, "paddingH": 12,
        "background": "transparent", "textColor": "#475569",
        "border": { "width": 0, "color": "transparent" },
        "shadow": "elevation-0",
        "font": "subhead"
      }
    },
    "card": {
      "padding": 20,
      "radius": 24,
      "background": "#FFFFFF",
      "border": { "width": 1, "color": "#E2E8F0" },
      "shadow": "elevation-1",
      "imageRatio": 1.33,
      "gap": 16
    },
    "input": {
      "height": 50,
      "radius": 16,
      "background": "#F8FAFC",
      "border": { "width": 1, "color": "#E2E8F0" },
      "focusBorder": { "width": 2, "color": "#2563EB" },
      "placeholder": "#94A3B8",
      "textColor": "#0F172A",
      "paddingH": 16,
      "font": "body",
      "error": { "border": { "width": 2, "color": "#DC2626" }, "messageColor": "#DC2626" }
    },
    "chip": {
      "height": 32,
      "radius": 9999,
      "paddingH": 12,
      "background": "#F1F5F9",
      "textColor": "#475569",
      "font": "caption1",
      "selected": { "background": "#DBEAFE", "textColor": "#1D4ED8" },
      "border": { "width": 0, "color": "transparent" }
    },
    "badge": {
      "size": 18,
      "radius": 9999,
      "background": "#DC2626",
      "textColor": "#FFFFFF",
      "font": "caption2",
      "position": "topTrailing"
    },
    "avatar": {
      "sm": { "size": 32, "radius": 9999, "border": { "width": 1.5, "color": "#FFFFFF" } },
      "md": { "size": 40, "radius": 9999, "border": { "width": 2, "color": "#FFFFFF" } },
      "lg": { "size": 56, "radius": 9999, "border": { "width": 3, "color": "#FFFFFF" } },
      "xl": { "size": 80, "radius": 24, "border": { "width": 3, "color": "#FFFFFF" } }
    },
    "divider": {
      "height": 1,
      "color": "#E2E8F0",
      "inset": 16,
      "style": "solid"
    },
    "toast": {
      "paddingH": 20,
      "paddingV": 14,
      "radius": 16,
      "background": "#0F172A",
      "textColor": "#FFFFFF",
      "font": "subhead",
      "position": "bottom",
      "duration": 3000
    },
    "sheet": {
      "radius": 24,
      "background": "#FFFFFF",
      "handleColor": "#CBD5E1",
      "handleWidth": 36,
      "handleHeight": 5,
      "padding": 20
    }
  },
  "iconography": {
    "style": "SF Symbols",
    "defaultWeight": "regular",
    "sizeMap": { "sm": 14, "md": 20, "lg": 24, "xl": 32, "nav": 24, "tab": 24, "button": 18 }
  },
  "composition": {
    "discovery": {
      "layoutDensity": "medium",
      "heroStyle": "carousel-full-width",
      "cardArrangement": "horizontal-scroll-rows + vertical-feed",
      "scrollBehavior": "infinite-scroll",
      "maxColumns": 1,
      "sectionHeaderStyle": "headline + tertiary-button"
    },
    "action": {
      "formDensity": "medium",
      "ctaPlacement": "fixed-bottom",
      "fieldGrouping": "grouped-sections",
      "progressStyle": "steps-indicator",
      "keyboardHandling": "next-field-on-return"
    },
    "consumption": {
      "mediaFill": "full-bleed-top-50pct",
      "chromeOpacity": "transparent-overlay",
      "infoPlacement": "sticky-below-media",
      "scrollEffect": "hero-parallax-shrink"
    },
    "management": {
      "rowDensity": "medium",
      "swipeStyle": "trailing-destructive-leading-primary",
      "sortPosition": "inline-above-list",
      "editModeTransition": "slide-in-bottom-bar"
    },
    "social": {
      "avatarProminence": "medium",
      "contentPadding": 16,
      "reactionStyle": "inline-icon-bar",
      "composePosition": "fixed-bottom-bar"
    }
  }
}
