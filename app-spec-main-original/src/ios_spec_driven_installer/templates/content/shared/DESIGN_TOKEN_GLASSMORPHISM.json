{
  "meta": {
    "name": "Glassmorphism",
    "version": "1.0",
    "description": "Translucent frosted glass surfaces floating over vibrant blurred backgrounds. Light passes through UI elements, creating depth through transparency and blur rather than shadows. Borders are luminous white strokes, backgrounds are layered gradient blurs, and text carries subtle glow for readability. Ideal for apps where the content behind the UI should remain partially visible — creating a sense of spatial awareness and lightness.",
    "mood": ["ethereal", "modern", "layered", "airy"],
    "visualWeight": "light-floating",
    "bestFor": ["music-player", "weather", "ar-navigation", "creative-showcase", "profile", "media-gallery"]
  },
  "color": {
    "palette": {
      "background": "linear-gradient(135deg, #E8D5F5, #D5E8F5, #F5E8D5)",
      "surface": "rgba(255,255,255,0.18)",
      "surfaceVariant": "rgba(255,255,255,0.10)",
      "surfaceElevated": "rgba(255,255,255,0.25)",
      "textPrimary": "rgba(0,0,0,0.85)",
      "textSecondary": "rgba(0,0,0,0.55)",
      "textTertiary": "rgba(0,0,0,0.35)",
      "textInverse": "rgba(255,255,255,0.95)",
      "accent": "#7C3AED",
      "accentVariant": "#A78BFA",
      "accentSubtle": "rgba(124,58,237,0.12)",
      "onAccent": "#FFFFFF"
    },
    "semantic": {
      "success": { "color": "#059669", "background": "rgba(5,150,105,0.12)" },
      "warning": { "color": "#D97706", "background": "rgba(217,119,6,0.12)" },
      "error": { "color": "#DC2626", "background": "rgba(220,38,38,0.12)" },
      "info": { "color": "#2563EB", "background": "rgba(37,99,235,0.12)" }
    },
    "gradient": [
      { "name": "pastelMesh", "colors": ["#E8D5F5", "#D5E8F5", "#F5E8D5", "#F5D5E8"], "angle": 0 },
      { "name": "glassOverlay", "colors": ["rgba(255,255,255,0.25)", "rgba(255,255,255,0.05)"], "angle": 180 }
    ]
  },
  "typography": {
    "fonts": {
      "primary": "SF Pro Display",
      "secondary": "SF Pro Text",
      "mono": "SF Mono"
    },
    "scale": {
      "caption2": { "size": 11, "weight": 400, "lineHeight": 13, "letterSpacing": 0.07 },
      "caption1": { "size": 12, "weight": 400, "lineHeight": 16, "letterSpacing": 0 },
      "footnote": { "size": 13, "weight": 400, "lineHeight": 18, "letterSpacing": -0.08 },
      "subhead": { "size": 15, "weight": 500, "lineHeight": 20, "letterSpacing": -0.24 },
      "callout": { "size": 16, "weight": 400, "lineHeight": 21, "letterSpacing": -0.32 },
      "body": { "size": 17, "weight": 400, "lineHeight": 22, "letterSpacing": -0.41 },
      "headline": { "size": 17, "weight": 600, "lineHeight": 22, "letterSpacing": -0.41 },
      "title3": { "size": 20, "weight": 600, "lineHeight": 25, "letterSpacing": -0.45 },
      "title2": { "size": 22, "weight": 600, "lineHeight": 28, "letterSpacing": -0.5 },
      "title1": { "size": 28, "weight": 700, "lineHeight": 34, "letterSpacing": -0.5 },
      "largeTitle": { "size": 34, "weight": 700, "lineHeight": 41, "letterSpacing": -0.5 },
      "hero": { "size": 44, "weight": 700, "lineHeight": 50, "letterSpacing": -0.5 }
    }
  },
  "spacing": {
    "grid": 4,
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 36,
    "xxl": 52,
    "pageMargin": 20,
    "sectionGap": 28,
    "cardPadding": 24,
    "navBarHeight": 48
  },
  "border": {
    "radius": {
      "none": 0,
      "sm": 8,
      "md": 16,
      "lg": 20,
      "xl": 28,
      "full": 9999
    },
    "width": 1,
    "color": "rgba(255,255,255,0.25)",
    "style": "solid"
  },
  "shadow": {
    "elevation": {
      "0": { "color": "transparent", "offsetY": 0, "blur": 0, "spread": 0 },
      "1": { "color": "rgba(0,0,0,0.04)", "offsetY": 4, "blur": 16, "spread": 0 },
      "2": { "color": "rgba(0,0,0,0.06)", "offsetY": 8, "blur": 32, "spread": 0 }
    }
  },
  "animation": {
    "duration": { "instant": 100, "fast": 200, "normal": 350, "slow": 550, "entrance": 450 },
    "easing": {
      "default": [0.25, 1, 0.5, 1],
      "easeIn": [0.42, 0, 1, 1],
      "easeOut": [0, 0, 0.58, 1],
      "easeInOut": [0.42, 0, 0.58, 1]
    },
    "spring": {
      "gentle": { "response": 0.6, "dampingFraction": 0.8 },
      "bouncy": { "response": 0.55, "dampingFraction": 0.65 },
      "snappy": { "response": 0.4, "dampingFraction": 0.82 }
    }
  },
  "component": {
    "navBar": {
      "height": 48,
      "background": "rgba(255,255,255,0.12)",
      "blur": 25,
      "hasDivider": false,
      "dividerColor": "transparent",
      "backIcon": { "name": "chevron.left", "weight": "medium", "size": 20 },
      "titleStyle": "title3",
      "actionIconSize": 24,
      "actionIconWeight": "medium",
      "horizontalPadding": 20,
      "textGlow": "0 0 10px rgba(255,255,255,0.5)"
    },
    "tabBar": {
      "height": 56,
      "background": "rgba(255,255,255,0.15)",
      "blur": 25,
      "hasDivider": false,
      "dividerColor": "transparent",
      "iconSize": 22,
      "labelStyle": "caption2",
      "activeColor": "#7C3AED",
      "inactiveColor": "rgba(0,0,0,0.35)",
      "badge": { "size": 16, "background": "#DC2626", "textColor": "#FFFFFF", "fontSize": 10 }
    },
    "button": {
      "primary": {
        "height": 52, "radius": 18, "paddingH": 28,
        "background": "rgba(124,58,237,0.85)", "textColor": "#FFFFFF",
        "border": { "width": 1, "color": "rgba(255,255,255,0.3)" },
        "shadow": "elevation-1",
        "font": "headline",
        "disabled": { "background": "rgba(255,255,255,0.10)", "textColor": "rgba(0,0,0,0.25)" },
        "blur": 10
      },
      "secondary": {
        "height": 52, "radius": 18, "paddingH": 28,
        "background": "rgba(255,255,255,0.20)", "textColor": "rgba(0,0,0,0.85)",
        "border": { "width": 1, "color": "rgba(255,255,255,0.25)" },
        "shadow": "elevation-0",
        "font": "headline",
        "blur": 10
      },
      "tertiary": {
        "height": 44, "radius": 14, "paddingH": 16,
        "background": "transparent", "textColor": "#7C3AED",
        "border": { "width": 0, "color": "transparent" },
        "shadow": "elevation-0",
        "font": "subhead"
      },
      "destructive": {
        "height": 52, "radius": 18, "paddingH": 28,
        "background": "rgba(220,38,38,0.85)", "textColor": "#FFFFFF",
        "border": { "width": 1, "color": "rgba(255,255,255,0.25)" },
        "shadow": "elevation-1",
        "font": "headline",
        "blur": 10
      },
      "ghost": {
        "height": 44, "radius": 14, "paddingH": 12,
        "background": "transparent", "textColor": "rgba(0,0,0,0.55)",
        "border": { "width": 0, "color": "transparent" },
        "shadow": "elevation-0",
        "font": "subhead"
      }
    },
    "card": {
      "padding": 24,
      "radius": 20,
      "background": "rgba(255,255,255,0.18)",
      "border": { "width": 1, "color": "rgba(255,255,255,0.25)" },
      "shadow": "elevation-1",
      "imageRatio": 1.5,
      "gap": 20,
      "blur": 15
    },
    "input": {
      "height": 52,
      "radius": 14,
      "background": "rgba(255,255,255,0.12)",
      "border": { "width": 1, "color": "rgba(255,255,255,0.20)" },
      "focusBorder": { "width": 1.5, "color": "#7C3AED" },
      "placeholder": "rgba(0,0,0,0.35)",
      "textColor": "rgba(0,0,0,0.85)",
      "paddingH": 16,
      "font": "body",
      "error": { "border": { "width": 1.5, "color": "#DC2626" }, "messageColor": "#DC2626" }
    },
    "chip": {
      "height": 34,
      "radius": 14,
      "paddingH": 14,
      "background": "rgba(255,255,255,0.15)",
      "textColor": "rgba(0,0,0,0.55)",
      "font": "caption1",
      "selected": { "background": "rgba(124,58,237,0.25)", "textColor": "#7C3AED" },
      "border": { "width": 1, "color": "rgba(255,255,255,0.20)" }
    },
    "badge": {
      "size": 18,
      "radius": 9999,
      "background": "#DC2626",
      "textColor": "#FFFFFF",
      "font": "caption2",
      "position": "topTrailing"
    },
    "avatar": {
      "sm": { "size": 32, "radius": 9999, "border": { "width": 2, "color": "rgba(255,255,255,0.4)" } },
      "md": { "size": 44, "radius": 9999, "border": { "width": 2.5, "color": "rgba(255,255,255,0.4)" } },
      "lg": { "size": 60, "radius": 9999, "border": { "width": 3, "color": "rgba(255,255,255,0.4)" } },
      "xl": { "size": 88, "radius": 24, "border": { "width": 3, "color": "rgba(255,255,255,0.4)" } }
    },
    "divider": {
      "height": 0.5,
      "color": "rgba(255,255,255,0.2)",
      "inset": 20,
      "style": "solid"
    },
    "toast": {
      "paddingH": 20,
      "paddingV": 14,
      "radius": 16,
      "background": "rgba(0,0,0,0.75)",
      "textColor": "#FFFFFF",
      "font": "subhead",
      "position": "bottom",
      "duration": 3000,
      "blur": 15,
      "border": { "width": 1, "color": "rgba(255,255,255,0.15)" }
    },
    "sheet": {
      "radius": 24,
      "background": "rgba(255,255,255,0.22)",
      "handleColor": "rgba(255,255,255,0.5)",
      "handleWidth": 40,
      "handleHeight": 5,
      "padding": 24,
      "blur": 20
    }
  },
  "iconography": {
    "style": "SF Symbols",
    "defaultWeight": "medium",
    "sizeMap": { "sm": 14, "md": 20, "lg": 24, "xl": 32, "nav": 24, "tab": 22, "button": 18 }
  },
  "composition": {
    "discovery": {
      "layoutDensity": "airy",
      "heroStyle": "glass-carousel-float",
      "cardArrangement": "floating-glass-grid",
      "scrollBehavior": "parallax-blur",
      "maxColumns": 2,
      "sectionHeaderStyle": "title3-glass-bg"
    },
    "action": {
      "formDensity": "airy",
      "ctaPlacement": "floating-glass-bottom",
      "fieldGrouping": "glass-section-cards",
      "progressStyle": "glass-dots",
      "keyboardHandling": "blur-background-on-focus"
    },
    "consumption": {
      "mediaFill": "full-bleed-behind-glass",
      "chromeOpacity": "frosted-glass-overlay",
      "infoPlacement": "floating-glass-card-bottom",
      "scrollEffect": "blur-behind-scroll"
    },
    "management": {
      "rowDensity": "airy",
      "swipeStyle": "glass-row-reveal",
      "sortPosition": "glass-segmented-control",
      "editModeTransition": "frost-fade"
    },
    "social": {
      "avatarProminence": "medium-glass-ring",
      "contentPadding": 24,
      "reactionStyle": "glass-icon-pills",
      "composePosition": "floating-glass-bar"
    }
  }
}
