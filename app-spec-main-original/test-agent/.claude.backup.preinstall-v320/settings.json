{
  "permissions": {
    "allow": [
      "mcp__XcodeBuildMCP__discover_projs",
      "mcp__XcodeBuildMCP__list_schemes",
      "mcp__XcodeBuildMCP__build_sim",
      "mcp__XcodeBuildMCP__build_run_sim",
      "mcp__XcodeBuildMCP__show_build_settings",
      "mcp__XcodeBuildMCP__screenshot",
      "mcp__XcodeBuildMCP__snapshot_ui",
      "mcp__XcodeBuildMCP__tap",
      "mcp__XcodeBuildMCP__gesture"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/update_task_status.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '✅ Session ended. Remember to commit your changes!'"
          }
        ]
      }
    ]
  }
}
